# ------------------------------------------------------------------
# Flamingo Fitness - Environment Variables
# Copy this file to ".env" and fill in real values.
# docker-compose reads this file automatically (env_file: .env).
# ------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Comma separated list. In production set DEBUG=False and list real hosts.

# --- PostgreSQL ---
POSTGRES_DB=flamingo_fitness
POSTGRES_USER=flamingo
POSTGRES_PASSWORD=flamingo-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (broker / cache) ---
REDIS_URL=redis://redis:6379/0

# --- External API keys (mock clients currently ignore these) ---
GARMIN_API_KEY=
PELOTON_API_KEY=
LIFTO SAUR_API_KEY=
