# ------------------------------------------------------------------
# Flamingo Fitness - Environment Variables
# ------------------------------------------------------------------
# Copy this file to ".env" and fill in real values before deploying.
#
# Portainer users:
#   - When creating a Stack, point Portainer at this repo/folder.
#   - Either upload a populated ".env" file, or set each variable
#     in the Portainer "Environment" editor UI.
#   - docker-compose.yml uses `env_file: .env` for all services.
# ------------------------------------------------------------------

# --- Django Core ---
# SECRET_KEY: Required. Use a long, random string in production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DEBUG: Set to False in production.
DJANGO_DEBUG=True
# ALLOWED_HOSTS: Comma-separated. Include your domain / container IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- PostgreSQL ---
POSTGRES_DB=flamingo_fitness
POSTGRES_USER=flamingo
POSTGRES_PASSWORD=flamingo-dev-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Celery broker / Django cache) ---
REDIS_URL=redis://redis:6379/0

# --- Demo Mode ---
# DEMO=True gates mock data (SparkyFitness payloads, demo accounts).
# Leave False in production so users see real "Link" CTAs.
DEMO=False

# --- External API Keys (optional, for future use) ---
# Paste real values to enable live sync; leave blank for demo data.
GARMIN_API_KEY=
PELOTON_API_KEY=
LIFTO_SAUR_API_KEY=
